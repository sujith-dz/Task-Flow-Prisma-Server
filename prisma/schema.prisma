generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  imageUrl      String?
  roleId        String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  isActive      Boolean  @default(true)
  
  // Relations
  role          Role     @relation(fields: [roleId], references: [id])
  assignedTasks TaskAssignee[]
  createdTasks  Task[]   @relation("TaskAssigner")

  // Indexes for common queries
  @@index([roleId, isActive]) // For admin filtering by role and active status
  @@index([isActive]) // For filtering active users
  @@index([roleId]) // For role-based queries
  @@map("users")
}

model Task {
  id           String     @id @default(uuid())
  title        String
  description   String?
  status       TaskStatus @default(TODO)
  assignerId   String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  priority     Priority   @default(MEDIUM)
  dueDate      DateTime?
  isDeleted    Boolean    @default(false)
  assigner     User       @relation("TaskAssigner", fields: [assignerId], references: [id], onDelete: Cascade)
  assignees    TaskAssignee[]
  documents    TaskDocumentMapping[]

  // Indexes for common query patterns
  @@index([isDeleted, assignerId]) // For user's own tasks (most common query)
  @@index([isDeleted, status]) // For filtering by status
  @@index([isDeleted, priority]) // For filtering by priority
  @@index([isDeleted, dueDate]) // For sorting and filtering by due date
  @@index([isDeleted, createdAt]) // For sorting by creation date
  @@index([isDeleted, assignerId, status]) // Composite for user dashboard with status filter
  @@index([isDeleted, assignerId, priority]) // Composite for user dashboard with priority filter
  @@index([assignerId]) // For finding tasks by creator
  @@index([status]) // For status-based analytics
  @@index([priority]) // For priority-based analytics
  @@index([dueDate]) // For due date sorting and filtering
  @@index([createdAt]) // For creation date sorting
  @@map("tasks")
}

model TaskAssignee {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Indexes for common queries
  @@index([userId]) // For finding all tasks assigned to a user (user dashboard)
  @@index([taskId]) // For finding all assignees of a task
  @@unique([taskId, userId])
  @@map("task_assignees")
}

// Roles table
model Role {
  id          String   @id @default(uuid())
  name        String   @unique  // e.g., "USER", "ADMIN", "MANAGER"
  displayName String   // e.g., "User", "Administrator", "Manager"
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  users       User[]
  permissions RolePermission[]
  
  @@index([name])
  @@index([isActive])
  @@map("roles")
}

// Permissions table
model Permission {
  id          String   @id @default(uuid())
  name        String   @unique  // e.g., "tasks:create", "tasks:edit", "users:delete"
  displayName String   // e.g., "Create Task", "Edit Task", "Delete User"
  description String?
  category    String   // e.g., "tasks", "users", "documents", "admin"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  roles       RolePermission[]
  
  @@index([category])
  @@index([name])
  @@index([isActive])
  @@map("permissions")
}

// Role-Permission mapping table
model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  
  // Relations
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// Document table (separated from task for optimization)
model Document {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  fileSize    Int?     // File size in bytes
  mimeType    String?  // MIME type of the file
  uploadedBy  String   // User ID who uploaded the document
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  tasks       TaskDocumentMapping[]
  
  @@index([uploadedBy])
  @@map("documents")
}

// Task-Document mapping table (optimized structure)
model TaskDocumentMapping {
  id         String   @id @default(uuid())
  taskId     String
  documentId String
  createdAt  DateTime @default(now())
  
  // Relations
  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  @@unique([taskId, documentId])
  @@index([taskId])
  @@index([documentId])
  @@map("task_document_mappings")
}

enum TaskStatus {
  TODO
  PENDING
  COMPLETED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}
